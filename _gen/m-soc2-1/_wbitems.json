[["개념01", 12, "(1) 총리(수상) (2) 대통령 (3) 조약"], ["개념02", 12, "(1) 대통령제 (2) 의원 내각제 (3) 입법 기관"], ["개념03", 12, "(1) ◯ (2) ◯ (3) × (4) × (5) ◯"], ["개념04", 12, "㉠: 국무 회의, ㉡: 감사원"], ["개념05", 12, "본회의 → 상임 위원회"], ["대표01", 12, "⑤"], ["대표02", 12, "⑤"], ["대표03", 12, "⑤"], ["대표04", 12, "⑤"], ["대표05", 12, "②"], ["대표05-1", 13, "②"], ["대표06", 13, "③"], ["대표07", 13, "③"], ["대표08", 13, "②"], ["대표09", 13, "①"], ["대표10", 14, "①"], ["대표10-1", 14, "②"], ["대표11", 14, "③"], ["대표12", 14, "⑤"], ["대표13", 14, "③"], ["서술01", 15, "(1) (가): 의원 내각제, (나): 대통령제 (2) (가) 의원 내각제는 입법부와 행정부의 관계가 밀접하고, (나) 대통령제는 입법부와 행정부가 엄격하게 분리되어 있다."], ["서술02", 15, "행정부와 국회 간의 협조를 통해 국가 정책을 효율적으로 수행하기 위해서야."], ["서술03", 15, "(1) ㉠: 행정부 수반, ㉡: 국가 원수 (2) 국회의 동의를 얻어 대법원장, 헌법재판소장 등을 임명하여 헌법 기관을 구성한다. 국민 투표를 시행할 수 있다. 나라가 위태로운 상황일 때 긴급 명령권을 행사하거나 계엄을 선포할 수 있다."], ["서술04", 15, "국무 회의"], ["개념01", 18, "(1) ◯ (2) × (3) ◯"], ["개념02", 18, "(1) ㄴ (2) ㄷ (3) ㄱ"], ["개념03", 18, "(1) 입법 (2) 법원 (3) 사법권"], ["개념04", 18, "(1) ㄹ (2) ㄴ (3) ㄷ (4) ㄱ"], ["개념05", 18, "㉠: 헌법 재판, ㉡: 헌법 소원 심판"], ["대표01", 18, "⑤"], ["대표02", 18, "②"], ["대표03", 18, "①"], ["대표04", 18, "①"], ["대표04-1", 18, "②"], ["대표05", 19, "③"], ["대표06", 19, "②"], ["대표07", 19, "①"], ["대표08", 19, "⑤"], ["대표09", 19, "④"], ["대표10", 20, "②"], ["대표11", 20, "④"], ["대표12", 20, "④"], ["대표12-1", 20, "⑤"], ["대표13", 20, "③"], ["서술01", 21, "(1) ㉠: 임명 동의권, ㉡: 일반 국정 (2) 매년 정기적으로 국정 전반을 점검하는 국정 감사나 필요할 때 특정 사안을 조사하는 국정 조사를 진행한다. 대통령, 국무총리 등 법률이 정한 공무원이 헌법이나 법률을 위반한 경우에는 탄핵 소추를 의결할 수 있다."], ["서술02", 21, "행정부가 세운 일 년 동안의 예산안을 심의·확정한다. 결산 심사를 통해 정부가 예산을 제대로 사용했는지 심사한다. 세금의 종류와 세율을 법률로 정한다."], ["서술03", 21, "공정한 재판을 통해 국민의 자유와 권리를 보장하기 위해서야."], ["서술04", 21, "(1) 대법원 (2) 대법원은 사법부의 최고 법원으로, 최종심을 담당한다."], ["서술05", 21, "(1) 위헌 법률 심판 (2) 재판 과정에서 재판에 적용되는 법률이 헌법에 위반되는지가 문제가 될 때 법원의 제청에 따라 법률의 위헌 여부를 판단하는 심판이다."], ["개념01", 32, "(1) 재화 (2) 서비스"], ["개념02", 32, "경제생활"], ["개념03", 32, "(1) 편익 (2) 기회비용"], ["개념04", 32, "(1) ㄴ (2) ㄹ (3) ㄷ (4) ㄱ"], ["개념05", 32, "(1) ◯ (2) ◯ (3) ×"], ["대표01", 32, "②"], ["대표02", 32, "③"], ["대표02-1", 32, "②"], ["대표03", 32, "②"], ["대표04", 32, "⑤"], ["대표04-1", 32, "①"], ["대표05", 33, "⑤"], ["대표06", 33, "④"], ["대표07", 33, "③"], ["대표08", 33, "③"], ["대표09", 33, "④"], ["대표10", 34, "①"], ["대표10-1", 34, "②"], ["대표11", 34, "⑤"], ["대표12", 34, "③"], ["대표13", 34, "⑤"], ["서술02", 35, "합리적 선택은 비용과 편익의 크기를 비교하여 최소의 비용으로 최대의 편익을 얻을 수 있도록 선택하는 것이다. 비용이 같다면 편익이 가장 큰 것을, 편익이 같다면 비용이 가장 적게 드는 것을 선택하는 것이 합리적이다."], ["서술03", 35, "기회비용이란 어떤 것을 선택함으로써 포기하게 되는 대안의 가치 중에서 가장 큰 것을 의미한다."], ["서술04", 35, "드라마를 볼 때 얻는 즐거움이야."], ["서술05", 35, "청년기, 취업을 하여 소득이 생겨나기 시작하는 시기이나 중·장년기에 비해 소득의 크기가 크지 않고 소비도 많지 않은 때이다."], ["서술06", 35, "노년기, 소비생활은 지속적으로 이루어지나 은퇴 후 근로 소득이 크게 줄어들거나 없어져 소비보다 소득이 적다."], ["개념01", 38, "(1) ㄴ (2) ㄱ (3) ㄷ"], ["개념02", 38, "(1) 주식 (2) 연금 (3) 보험"], ["개념03", 38, "신용"], ["개념04", 38, "비용 → 이윤"], ["개념05", 38, "㉠: 사회적 책임, ㉡: 기업가 정신"], ["대표01", 38, "④"], ["대표01-1", 38, "⑤"], ["대표02", 38, "③"], ["대표03", 38, "③"], ["대표04", 38, "①"], ["대표05", 39, "③"], ["대표06", 39, "③"], ["대표07", 39, "②"], ["대표08", 39, "④"], ["대표09", 39, "④"], ["대표10", 40, "⑤"], ["대표10-1", 40, "④"], ["대표11", 40, "③"], ["대표12", 40, "①"], ["대표13", 40, "⑤"], ["서술01", 41, "㉠: 수익성, ㉡: 유동성"], ["서술02", 41, "(가)는 예금과 적금이고, (나)는 주식이다. 예·적금은 안전성이 높고 수익성이 낮은 반면, 주식은 수익성이 높고 안전성이 낮은 편이다."], ["개념01", 52, "(1) × (2) ◯ (3) ×"], ["개념02", 52, "(1) ㄴ, ㄷ (2) ㄱ, ㄹ"], ["개념03", 52, "(1) 시장 (2) 수요 (3) 공급 곡선"], ["개념04", 52, "(1) 재화, 서비스 (2) 공급량 (3) 초과 수요  \b"], ["개념05", 52, "㉠: 균형 가격, ㉡: 균형 거래량"], ["대표01", 52, "①"], ["대표02", 52, "③"], ["대표03", 52, "①"], ["대표04", 52, "④"], ["대표05", 52, "⑤"], ["대표05-1", 52, "②"], ["대표06", 53, "②"], ["대표07", 53, "⑤"], ["대표08", 53, "④"], ["대표09", 53, "④"], ["대표10", 53, "③"], ["대표11", 53, "①"], ["대표11-1", 54, "③"], ["대표12", 54, "③"], ["대표13", 54, "④"], ["대표14", 54, "③"], ["대표15", 54, "④"], ["서술01", 55, "(가): 생산물 시장, (나): 생산 요소 시장"], ["서술02", 55, "물물 교환을 위해 물건을 직접 들고 다녀야 한다. 그리고 서로가 원하는 물건이 일치하는 상대방을 찾아야 한다. 이와 같은 어려움을 해결하고 교환을 쉽고 편리하게 하기 위해 시장이 필요하다."], ["서술03", 55, "수요 법칙, 가격이 상승하면 수요량이 감소하고 가격이 하락하면 수요량이 증가하는 현상이다."], ["서술04", 55, "수요자들 간의 경쟁으로 상품의 가격이 상승하여 수요량이 감소하고 공급량이 증가하여 초과 수요가 줄어든다."], ["개념01", 58, "(1) 늘어난다 (2) 보완재 (3) 왼쪽"], ["개념02", 58, "㉠: 대체재, ㉡: 보완재"], ["개념03", 58, "(1) ◯ (2) × (3) × (4) ◯"], ["개념04", 58, "하락하고 → 상승하고(올라가고, 오르고)"], ["개념05", 58, "ㄱ, ㄷ"], ["대표01", 58, "⑤"], ["대표02", 58, "⑤"], ["대표03", 58, "⑤"], ["대표04", 58, "⑤"], ["대표04-1", 58, "②"], ["대표05", 59, "②"], ["대표06", 59, "③"], ["대표07", 59, "①"], ["대표08", 59, "④"], ["대표09", 59, "④"], ["대표10", 60, "②"], ["대표10-1", 60, "④"], ["대표11", 60, "②"], ["대표12", 60, "④"], ["대표13", 60, "④"], ["서술01", 61, "㉠: 감소, ㉡: 상승"], ["서술02", 61, "대체재, 사이다 가격이 상승하면 사람들은 사이다를 대신하여 마실 수 있는 콜라를 찾기 때문에 콜라의 수요가 증가한다."], ["서술03", 61, "자료에 공통으로 나타난 붕어빵의 공급 변화 요인은"], ["개념01", 72, "국내 총생산(GDP)"], ["개념02", 72, "(1) ◯ (2) × (3) ◯ (4) ×"], ["개념03", 72, "(1) 물가 (2) 인플레이션 (3) 정부"], ["개념04", 72, "(1) 떨어 (2) 유리 (3) 디플레이션\b"], ["개념05", 72, "ㄴ, ㄷ"], ["대표01", 72, "⑤"], ["대표02", 72, "⑤"], ["대표03", 72, "⑤"], ["대표04", 72, "④"], ["대표04-1", 72, "②"], ["대표05", 73, "③"], ["대표06", 73, "③"], ["대표07", 73, "②"], ["대표08", 73, "③"], ["대표09", 73, "④"], ["대표09-1", 74, "②"], ["대표10", 74, "④"], ["대표11", 74, "①"], ["대표12", 74, "③"], ["대표13", 74, "②"], ["서술01", 75, "(가) 경제 성장의 긍정적 측면의 사례로 의료 기술이 발달해 기대 수명이 늘어나는 것, 다양한 문화 시설이 보급되는 것이 들어갈 수 있다. (나) 경제 성장의 부정적 측면의 사례로 빈부 격차가 심화되는 것, 환경 오염이 심화되는 것이 들어갈 수 있다."], ["개념01", 78, "㉠: 일할 능력, ㉡: 일할 의사"], ["개념02", 78, "(1) ㄴ (2) ㄱ (3) ㄹ (4) ㄷ\b"], ["개념03", 78, "서비스"], ["개념04", 78, "(1) ◯ (2) × (3) ◯"], ["개념05", 78, "(1) 공 (2) 공 (3) 수"], ["대표01", 78, "①"], ["대표02", 78, "⑤"], ["대표03", 78, "③"], ["대표03-1", 78, "⑤"], ["대표04", 78, "⑤"], ["대표05", 78, "③"], ["대표06", 79, "②"], ["대표07", 79, "③"], ["대표08", 79, "③"], ["대표08-1", 79, "②"], ["대표09", 79, "②"], ["대표10", 80, "④"], ["대표11", 80, "④"], ["대표12", 80, "②"], ["대표13", 80, "④"], ["대표14", 80, "②"], ["서술01", 81, "㉠: 일할 능력과 일할 의사가 있는데도 일자리를 갖지 못한 상태, ㉡: 학업을 위해 일하지 않는 학생, 가사에 전념하는 전업주부"], ["서술02", 81, "구조적 실업, 구조적 실업은 산업 구조의 변화나 기술 발달로 일자리가 사라져 발생한다."], ["개념01", 92, "(1) 국제 사회 (2) 힘의 논리 (3) 국제 분쟁"], ["개념02", 92, "(1) 국가 (2) 다국적 기업 (3) 자국"], ["개념03", 92, "(1) × (2) × (3) ◯ (4) ◯"], ["개념04", 92, "㉠: 정부 간 국제기구, ㉡: 국제 비정부 기구"], ["개념05", 92, "ㄴ, ㄷ"], ["대표01", 92, "①"], ["대표02", 92, "③"], ["대표02-1", 92, "②"], ["대표03", 92, "②"], ["대표04", 92, "①"], ["대표04-1", 93, "①"], ["대표05", 93, "③"], ["대표05-1", 93, "⑤"], ["대표06", 93, "②"], ["대표07", 93, "④"], ["대표08", 94, "⑤"], ["대표09", 94, "①"], ["대표10", 94, "②"], ["대표11", 94, "④"], ["대표12", 94, "①"], ["서술01", 95, "(1) ㉠: 정부 간 국제기구, ㉡: 국제 비정부 기구 (2) ㉠은 각국 정부를 회원으로 하는 국제기구이고, ㉡은 개인이나 민간단체를 회원으로 하는 국제기구이다."], ["서술02", 95, "국제 사회를 구성하는 가장 기본적인 행위 주체이다. 독립적인 주권을 행사한다. 자국의 이익을 위해 외교 활동을 수행한다."], ["서술03", 95, "다국적 기업"], ["서술04", 95, "(가)에는 전 지구적 차원의 문제를 해결하기 위해 국제 협력이 이루어지는 모습이 나타나 있다. (나)에는 각국이 자국의 이익을 우선으로 한다는 국제 사회의 특징이 나타나 있다."], ["서술05", 95, "여러 가지 원인이 복잡하게 얽혀 있기 때문에 분쟁을 조정하고 해결하기 어렵다."], ["개념01", 98, "다중적 시민"], ["개념02", 98, "(1) 안보 문제 (2) 높아 (3) 정부"], ["개념03", 98, "(1) × (2) ◯ (3) ◯"], ["개념04", 98, "㉠: 안보 문제, ㉡: 경제 문제"], ["개념05", 98, "(1) ㄱ (2) ㄴ (3) ㄷ"], ["대표01", 98, "④"], ["대표02", 98, "①"], ["대표02-1", 98, "⑤"], ["대표03", 98, "③"], ["대표04", 98, "③"], ["대표05", 99, "①"], ["대표06", 99, "④"], ["대표07", 99, "②"], ["대표08", 99, "①"], ["대표09", 99, "④"], ["대표09-1", 100, "③"], ["대표10", 100, "①"], ["대표11", 100, "⑤"], ["대표12", 100, "②"], ["대표13", 100, "①"], ["서술01", 101, "(1) 세계 시민 (2) 국제 사회 분쟁을 특정 지역이나 국가 중심의 입장이 아니라 균형 잡힌 시각에서 바라본다. 다양한 문화를 편견 없이 이해하고 존중하는 태도를 지닌다. 보편적 인권 존중 의식과 지구촌 공동체 구성원으로서의 연대감을 가지고 문제 해결에 적극적으로 동참한다."], ["서술02", 101, "(1) 안보 문제 (2) 군사적 긴장감이 조성될 수 있다. 국방비 지출이 늘어날 수 있다. 다른 나라가 우리나라를 위험 지역으로 인식하게 하여 경제 발전에 부담을 줄 수 있다."], ["서술04", 101, "(1) 경제 문제 (2) 식량, 자원 등의 수입을 특정 국가에만 의존하지 않도록 다변화한다. 세계 경제 변화에 대응하기 위해 대외 위험 요소를 파악하고, 국내법과 제도를 정비하며, 경제 성장을 주도하는 연구 개발에 투자해야 한다."], ["서술05", 101, "찬성 측 근거로는 인간 존엄성 보장을 위해 난민 인정률을 높여야 한다는 점을 들 수 있고, 반대 측 근거로는 난민 정착 비용에 대한 경제적 부담이 있다는 점을 들 수 있다."], ["개념01", 112, "(1) 사회 변동 (2) 상호 의존성 (3) 다문화"], ["개념02", 112, "(1) 빈부 격차\b (2) 서비스 (3) 노인 인구 비율"], ["개념03", 112, "(1) × (2) × (3) ◯"], ["개념04", 112, "세계화"], ["개념05", 112, "ㄱ, ㄷ, ㄹ"], ["대표01", 112, "⑤"], ["대표02", 112, "②"], ["대표02-1", 112, "③"], ["대표03", 112, "②"], ["대표04", 112, "④"], ["대표05", 113, "④"], ["대표06", 113, "③"], ["대표07", 113, "②"], ["대표08", 113, "⑤"], ["대표09", 113, "③"], ["대표09-1", 114, "⑤"], ["대표10", 114, "⑤"], ["대표11", 114, "④"], ["대표12", 114, "⑤"], ["대표13", 114, "②"], ["서술01", 115, "(1) 세계화 (2) 세계화가 진행되면서 국가 간 경제적 교류가 활발해지고, 소비 시장이 확대되며 인적·문화적 교류도 증가하 였다."], ["개념01", 118, "(1) × (2) × (3) × (4) ◯ (5) ◯"], ["개념02", 118, "시간과 장소에 상관없이 항상 같은 형태로 나타난다. → 시간과 장소에 따라 다르게 나타난다."], ["개념03", 118, "기후위기 문제"], ["개념04", 118, "(1) 개발 도상국 (2) 노동 (3) 팬데믹"], ["대표01", 118, "⑤"], ["대표02", 118, "②"], ["대표02-1", 118, "⑤"], ["대표03", 118, "④"], ["대표04", 118, "⑤"], ["대표05", 119, "②"], ["대표06", 119, "③"], ["대표07", 119, "⑤"], ["대표08", 119, "①"], ["대표09", 119, "③"], ["대표09-1", 120, "④"], ["대표10", 120, "②"], ["대표11", 120, "⑤"], ["대표12", 120, "①"], ["대표13", 120, "②"], ["서술01", 121, "사회 문제는 시간과 장소에 따라 다르게 인식되기도 한다."], ["서술02", 121, "기후위기 문제"], ["서술03", 121, "사회 불평등이 지속되면 불평등한 위치에 놓인 사람들의 삶의 질이 하락한다. 사회 구성원 간의 갈등과 대립이 발생하여 사회 통합이 어렵게 된다."]]