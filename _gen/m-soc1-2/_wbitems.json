[["개념01", 12, "(1) 사회화 (2) 대중 매체 (3) 자아 정체성"], ["개념02", 12, "(1) × (2) ◯ (3) ◯ (4) ×"], ["개념03", 12, "(1) ㄷ (2) ㄱ (3) ㄴ"], ["개념04", 12, "재사회화"], ["대표01", 12, "④"], ["대표02", 12, "①"], ["대표03", 12, "③"], ["대표04", 12, "③"], ["대표04-1", 12, "④"], ["대표05", 13, "④"], ["대표06", 13, "②"], ["대표07", 13, "⑤"], ["대표08", 13, "②"], ["대표09", 13, "②"], ["대표10", 14, "②"], ["대표10-1", 14, "③"], ["대표11", 14, "⑤"], ["대표12", 14, "⑤"], ["대표13", 14, "③"], ["서술01", 15, "㉠: 자신이 속한 사회에 적응하고, 자신만의 고유한 자아 정체성을 형성한다. ㉡: 자신이 속한 사회의 문화를 다음 세대에 전달하여 사회를 유지하고 발전시킨다."], ["서술02", 15, "인간은 다른 사람들과 상호 작용하면서 사회화 과정을 거쳐야 인간답게 성장할 수 있는 사회적 존재이다."], ["서술04", 15, "자아 정체성"], ["서술05", 15, "재사회화, 현대 사회는 사회가 급격하게 변하기 때문에 이에 적응하기 위해 새로운 지식과 생활 양식을 습득해야 한다."], ["개념01", 18, "(1) × (2) ◯ (3) × (4) ◯"], ["개념02", 18, "(1) 사회적 지위 (2) 성취 지위 (3) 역할 갈등 (4) 우선순위 (5) 차별"], ["개념03", 18, "(1) 귀속 지위 (2) 제재 (3) 갈등"], ["개념04", 18, "ㄴ, ㄷ"], ["대표01", 18, "④"], ["대표02", 18, "③"], ["대표03", 18, "①"], ["대표04", 18, "⑤"], ["대표05", 18, "①"], ["대표06", 18, "⑤"], ["대표07", 19, "④"], ["대표08", 19, "②"], ["대표09", 19, "②"], ["대표09-1", 19, "③"], ["대표10", 19, "②"], ["대표11", 20, "⑤"], ["대표12", 20, "②"], ["대표13", 20, "③"], ["대표14", 20, "⑤"], ["대표15", 20, "②"], ["서술01", 21, "(중)학생, 펜싱 선수"], ["서술02", 21, "(가)는 귀속 지위로, 개인의 노력과 상관없이 태어나면서부터 자연적으로 가지게 되는 지위이다. (나)는 성취 지위이며 개인의 노력이나 능력을 통해 후천적으로 얻게 되는 지위이다."], ["서술03", 21, "㉠ 갈등, ㉡ 차별"], ["서술04", 21, "(1) 역할 갈등 (2) 댄스 동아리 회장으로서 연습에 참여해야 하는 역할과 동생으로서 언니의 생일을 축하하는 자리에 참석해야 할 역할이 서로 충돌하기 때문에 역할 갈등이 발생하였다."], ["개념01", 32, "(1) 문화 (2) 보편성 (3) 공유성 (4) 학습성 (5) 변동성"], ["개념02", 32, "(1) ◯ (2) ◯ (3) ×"], ["개념03", 32, "전체성"], ["개념04", 32, "㉠ 보편성 ㉡ 다양성(특수성)"], ["대표01", 32, "①"], ["대표02", 32, "⑤"], ["대표03", 32, "④"], ["대표04", 32, "②"], ["대표05", 32, "①"], ["대표06", 33, "①"], ["대표07", 33, "③"], ["대표08", 33, "①"], ["대표09", 33, "④"], ["대표10", 33, "②"], ["대표11", 34, "③"], ["대표12", 34, "①"], ["대표13", 34, "⑤"], ["대표13-1", 34, "④"], ["대표14", 34, "①"], ["서술01", 35, "(가), 문화는 한 사회 구성원이 만들어 낸 공통의 생활 양식으로, 개인적인 버릇이나 본능에 의한 행동은 문화에 해당하지 않는다."], ["서술02", 35, "다양성(특수성)"], ["서술04", 35, "문화는 고정된 것이 아니라 변화한다는 점에서 문화의 변동성을, 문화는 세대를 통해 전승되고 축적되면서 그 내용이 더욱 풍부하고 다양해진다는 점에서 문화의 축적성을 알 수 있다."], ["개념01", 38, "(1) 획일화 (2) 다르게 (3) 다양하게 (4) 자문화 중심주의 (5) 문화 상대주의"], ["개념02", 38, "(1) ㄱ (2) ㄴ (3) ㄷ"], ["개념03", 38, "일방향 → 쌍방향"], ["개념04", 38, "자문화 중심주의"], ["대표01", 38, "④"], ["대표02", 38, "③"], ["대표03", 38, "②"], ["대표04", 38, "③"], ["대표05", 38, "①"], ["대표06", 39, "⑤"], ["대표07", 39, "⑤"], ["대표08", 39, "④"], ["대표09", 39, "⑤"], ["대표10", 39, "⑤"], ["대표10-1", 40, "④"], ["대표11", 40, "②"], ["대표12", 40, "⑤"], ["대표13", 40, "⑤"], ["서술02", 41, "정보 제공자와 수용자 간의 쌍방향 소통을 가능하게 한다. 사람들은 시간과 공간의 제약 없이 실시간으로 소통한다."], ["서술03", 41, "미디어 리터러시"], ["서술04", 41, "갑은 문화 상대주의, 을은 자문화 중심주의, 병은 문화 사대주의에 해당한다."], ["서술05", 41, "문화 상대주의"], ["개념01", 52, "(1) 정치 (2) 대의 민주주의 (3) 인간의 존엄성"], ["개념02", 52, "(1) × (2) ◯ (3) ×"], ["개념03", 52, "㉠ 직접 민주주의 ㉡ 모든 사회 구성원"], ["개념04", 52, "(1) 근대 시민 혁명 (2) 보통 선거"], ["개념05", 52, "(1) ㄷ (2) ㄱ (3) ㄴ"], ["대표01", 52, "⑤"], ["대표02", 52, "②"], ["대표03", 52, "①"], ["대표04", 52, "②"], ["대표05", 52, "④"], ["대표06", 53, "①"], ["대표07", 53, "②"], ["대표08", 53, "③"], ["대표09", 53, "⑤"], ["대표10", 53, "⑤"], ["대표11", 54, "①"], ["대표11-1", 54, "④"], ["대표12", 54, "②"], ["대표13", 54, "④"], ["대표13-1", 54, "③"], ["서술01", 55, "체험 학습 장소를 정하기 위한 학급 회의, 지역 문제를 해결하기 위한 주민 회의"], ["서술02", 55, "보통 선거 제도"], ["서술03", 55, "인간의 존엄성"], ["서술04", 55, "(1) 대의 민주주의(간접 민주주의) (2) 근대 민주주의에서는 재산이 있는 성인 남성만 정치에 참여할 수 있었지만, 현대 민주주의에서는 모든 사회 구성원이 정치에 참여할 수 있다."], ["서술05", 55, "(1) (가) 입헌주의의 원리, (나) 권력 분립의 원리 (2) 국가 권력 남용을 방지하고 국민의 자유와 권리를 보장하고자 한다."], ["개념01", 58, "(1) 간접 (2) 전자"], ["개념02", 58, "ㄴ, ㄷ"], ["개념03", 58, "(1) × (2) ◯"], ["개념04", 58, "(1) ㄷ (2) ㄱ (3) ㄴ"], ["개념05", 58, "(1) 정치적 무관심 (2) 공론장"], ["대표01", 58, "①"], ["대표02", 58, "②"], ["대표03", 58, "⑤"], ["대표04", 58, "①"], ["대표04-1", 58, "⑤"], ["대표05", 59, "④"], ["대표06", 59, "①"], ["대표06-1", 59, "①"], ["대표07", 59, "②"], ["대표08", 59, "⑤"], ["대표09", 60, "②"], ["대표10", 60, "④"], ["대표11", 60, "②"], ["대표12", 60, "⑤"], ["대표13", 60, "④"], ["서술01", 61, "간접 민주주의(대의 민주주의)"], ["서술02", 61, "대표자의 결정이 국민의 의사와 완전히 일치하지 않을 수 있다. 모든 직업, 지역, 계층별 의견을 고르게 대표하기 어렵다. 정치적 무관심이 확대되는 문제가 나타난다."], ["서술03", 61, "전자 민주주의"], ["서술04", 61, "정치적 무관심"], ["서술05", 61, "대표자에 관한 시민의 비판과 감시가 소홀해질 수 있다. 대표자의 정책에 관한 검증이 제대로 이루어지지 않을 수 있다."], ["개념01", 72, "직접 민주제 → 대의제(간접 민주제)"], ["개념02", 72, "(1) 평등 선거 (2) 직접 선거 (3) 보통 선거 (4) 비밀 선거"], ["개념03", 72, "유권자"], ["개념04", 72, "(1) ◯ (2) ◯ (3) ◯ (4) ×"], ["개념05", 72, "정당"], ["대표01", 72, "②"], ["대표02", 72, "④"], ["대표03", 72, "④"], ["대표04", 72, "①"], ["대표04-1", 72, "③"], ["대표05", 73, "④"], ["대표06", 73, "③"], ["대표07", 73, "⑤"], ["대표08", 73, "②"], ["대표09", 73, "②"], ["대표09-1", 74, "②"], ["대표10", 74, "③"], ["대표11", 74, "③"], ["대표12", 74, "④"], ["대표13", 74, "②"], ["서술01", 75, "대표가 맡은 일을 제대로 수행하지 않을 경우 다음 선거에서 대표자를 교체함으로써 정치권력을 통제하는 기능이 있다."], ["서술02", 75, "㉠ 국회, ㉡ 정부"], ["서술03", 75, "평등 선거의 원칙, 모든 유권자가 동등한 가치의 투표권을 가져야 한다는 원칙이다."], ["서술04", 75, "\u0007(1) (가) 이익 집단, (나) 시민 단체 (2) (가)는 자신들의 특수한 이익 실현을 목적으로 하며, (나)는 사회 전체의 공익 실현을 목적으로 한다."], ["서술05", 75, "각종 선거에 후보자를 공천하여 대표자로 당선시키고자 노력한다."], ["개념01", 78, "이익 집약"], ["개념02", 78, "지방 자치"], ["개념03", 78, "(1) 의 (2) 단 (3) 의 (4) 단"], ["개념04", 78, "(1) × (2) ◯ (3) ◯ (4) ◯"], ["개념05", 78, "주민 조례 발안 제도"], ["대표01", 78, "④"], ["대표02", 78, "⑤"], ["대표03", 78, "③"], ["대표04", 78, "③"], ["대표04-1", 78, "①"], ["대표05", 78, "⑤"], ["대표06", 79, "④"], ["대표07", 79, "⑤"], ["대표08", 79, "⑤"], ["대표09", 79, "①"], ["대표10", 79, "②"], ["대표11", 80, "⑤"], ["대표12", 80, "⑤"], ["대표13", 80, "①"], ["대표13-1", 80, "①"], ["대표14", 80, "②"], ["서술01", 81, "정치 과정"], ["서술02", 81, "이익 집약, 정당과 언론 등이 표출된 이익을 모아 여론을 형성한다."], ["서술03", 81, "지방 자치 단체에 민원 또는 청원을 제기한다. 공청회나 주민 설명회 등에 참가한다. 주민 투표, 주민 조례 발안 제도, 주민 참여 예산제, 주민 소환제, 주민 감사 청구제 등의 제도를 활용한다."], ["개념01", 92, "(1) × (2) ◯ (3) × (4) ×"], ["개념02", 92, "법"], ["개념03", 92, "(1) - ㄷ (2) - ㄱ (3) - ㄴ"], ["개념04", 92, "사회법"], ["개념05", 92, "(1) 강제성 (2) 공법 (3) 민법 (4) 사회 보장법"], ["대표01", 92, "③"], ["대표02", 92, "②"], ["대표02-1", 92, "②"], ["대표03", 92, "③"], ["대표04", 92, "①"], ["대표05", 93, "①"], ["대표06", 93, "④"], ["대표07", 93, "①"], ["대표07-1", 93, "⑤"], ["대표08", 93, "④"], ["대표09", 94, "③"], ["대표10", 94, "④"], ["대표11", 94, "②"], ["대표11-1", 94, "①"], ["대표12", 94, "⑤"], ["서술01", 95, "㉠은 도덕, ㉡은 법이다. 도덕은 인간 내면의 양심이나 동기를 중시하지만, 법은 행위와 그 결과를 중시한다. 도덕을 위반할 경우 양심의 가책이나 사회적 비난을 받지만, 법을 어겼을 경우 국가에 의한 제재를 받는다."], ["서술03", 95, "㉠: 사법, ㉡: 공법"], ["개념01", 98, "재판"], ["개념02", 98, "(1) 민 (2) 형 (3) 형 (4) 민"], ["개념03", 98, "(1) 형사 재판 (2) 원고 (3) 공개 재판주의"], ["개념04", 98, "심급 제도"], ["개념05", 98, "㉠: 항소, ㉡: 상고"], ["대표01", 98, "①"], ["대표02", 98, "④"], ["대표03", 98, "②"], ["대표04", 98, "③"], ["대표05", 98, "①"], ["대표05-1", 99, "④"], ["대표06", 99, "③"], ["대표07", 99, "⑤"], ["대표08", 99, "⑤"], ["대표09", 99, "②"], ["대표10", 100, "②"], ["대표11", 100, "④"], ["대표12", 100, "⑤"], ["대표13", 100, "③"], ["대표13-1", 100, "③"], ["서술01", 101, "(1) 재판 (2) 소송을 위한 절차와 진행 방법이 복잡하다는 것이다. 최종 판결까지 오랜 기간이 필요하다는 것이다. 변호사를 선임할 경우 비용이 발생하여 분쟁 당사자에게 부담이 될 수 있다는 것이다."], ["서술02", 101, "(가)는 민사 재판, (나)는 형사 재판이다. 민사 재판은 개인과 개인 사이의 권리와 의무에 관한 분쟁을 해결한다. 형사 재판은 범죄가 발생했을 때 범죄 여부를 판단하고 형벌의 종류와 정도를 정한다."], ["서술03", 101, "사법권의 독립"], ["서술04", 101, "공개 재판주의"], ["서술05", 101, "(1) ㉠: 상고, ㉡: 항소 (2) 심급 제도, 법관의 잘못된 판결로 발생할 수 있는 국민의 피해를 최소화한다. 공정한 재판을 실현하여 국민의 기본권을 보장한다."], ["개념01", 112, "(1) 인권 (2) 헌법 (3) 자유권"], ["개념02", 112, "(1) ㄴ (2) ㄷ (3) ㄱ"], ["개념03", 112, "국가 안전 보장, 법률, 없다"], ["개념04", 112, "ㄴ, ㄷ"], ["개념05", 112, "(1) × (2) ×"], ["대표01", 112, "②"], ["대표01-1", 112, "②"], ["대표02", 112, "①"], ["대표03", 112, "⑤"], ["대표04", 112, "②"], ["대표05", 113, "①"], ["대표06", 113, "⑤"], ["대표07", 113, "③"], ["대표07-1", 113, "⑤"], ["대표08", 113, "②"], ["대표09", 114, "②"], ["대표10", 114, "④"], ["대표11", 114, "③"], ["대표12", 114, "①"], ["대표13", 114, "①"], ["서술01", 115, "(1) 인권 (2) 인간이 태어나면서부터 갖게 되는 권리이다. 국가가 법으로 보장하기 전에 이미 인간에게 주어진 권리이다. 모든 사람에게 차별 없이 부여되는 보편적인 권리이다. 다른 사람이나 국가 기관이 함부로 침해할 수 없는 권리이다."], ["서술02", 115, "㉠: 헌법, ㉡: 기본권"], ["서술03", 115, "사회권, 사회권은 국가에 대해 인간다운 생활의 보장을 요구할 수 있는 권리이다."], ["서술05", 115, "(1) 참정권 (2) 선거권, 공무 담임권, 국민 투표권"], ["서술06", 115, "(1) 법률 (2) 국가 권력의 남용을 방지하여 국민의 자유와 권리를 최대한 보장하기 위함이다."], ["개념01", 118, "(1) ㄱ (2) ㄴ (3) ㄷ"], ["개념02", 118, "(1) ◯ (2) ×"], ["개념03", 118, "노동 3권"], ["개념04", 118, "(1) ㄱ (2) ㄷ (3) ㄴ"], ["개념05", 118, "(1) 부당 노동 행위 (2) 고용 노동부"], ["대표01", 118, "①"], ["대표01-1", 118, "⑤"], ["대표02", 118, "④"], ["대표03", 118, "②"], ["대표04", 118, "④"], ["대표05", 119, "⑤"], ["대표06", 119, "①"], ["대표06-1", 119, "⑤"], ["대표07", 119, "②"], ["대표08", 119, "⑤"], ["대표09", 120, "②"], ["대표10", 120, "③"], ["대표11", 120, "②"], ["대표12", 120, "③"], ["대표13", 120, "⑤"], ["서술01", 121, "헌법재판소"], ["서술02", 121, "단결권, 단체 교섭권, 단체 행동권"], ["서술03", 121, "근로자의 인간다운 생활을 보장하기 위함이다."], ["서술04", 121, "최저 임금을 모두 받을 수 있습니다. 임금은 본인이 직접 받아야 합니다."]]