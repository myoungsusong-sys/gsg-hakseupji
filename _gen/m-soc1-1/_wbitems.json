[["개념01", 12, "위치"], ["개념02", 12, "(1) 상대적 위치 (2) 위도 (3) 기후 (4) 한대"], ["개념03", 12, "(1) ㄷ (2) ㄹ (3) ㄱ (4) ㄴ"], ["개념04", 12, "(1) ㄷ (2) ㄴ (3) ㄱ"], ["대표01", 12, "②"], ["대표02", 12, "②"], ["대표03", 12, "③"], ["대표04", 12, "④"], ["대표04-1", 12, "③"], ["대표05", 13, "③"], ["대표06", 13, "⑤"], ["대표07", 13, "②"], ["대표08", 13, "②"], ["대표09", 13, "②"], ["대표10", 14, "④"], ["대표10-1", 14, "①"], ["대표11", 14, "④"], ["대표12", 14, "⑤"], ["대표13", 14, "①"], ["서술01", 15, "싱가포르는 북위 0°~2°, 동경 103°~104° 사이에 위치하며, 말레이반도의 끝에 위치한 섬나라이다."], ["서술02", 15, "(가), 지구는 둥글기 때문에 지역에 따라 햇볕을 받는 양에 차이가 있다. (가) 지역은 햇볕이 수직으로 들어와 좁은 지역에 열이 집중된다."], ["서술03", 15, "(1) 건조 기후 (2) 강수량이 증발량보다 적다. 사막이 넓게 분포한다. 사막의 모래바람을 피하고 열기를 막기 위해 길고 헐렁한 옷을 입는다. 등"], ["서술04", 15, "지역의 위치와 자연환경, 인문환경이 결합하여 나타나는 지역의 특성이 지역마다 다르게 나타나기 때문이다."], ["개념01", 18, "(1) 공간적 상호 작용 (2) 세계화 (3) 지역화"], ["개념02", 18, "(1) ◯ (2) ◯ (3) × (4) ×"], ["개념03", 18, "지역"], ["개념04", 18, "(1) ㄴ (2) ㄱ"], ["대표01", 18, "①"], ["대표02", 18, "③"], ["대표03", 18, "⑤"], ["대표04", 18, "④"], ["대표05", 18, "②"], ["대표05-1", 19, "④"], ["대표06", 19, "⑤"], ["대표07", 19, "③"], ["대표08", 19, "④"], ["대표09", 19, "⑤"], ["대표10", 20, "①"], ["대표10-1", 20, "⑤"], ["대표11", 20, "④"], ["대표12", 20, "③"], ["대표13", 20, "⑤"], ["서술01", 21, "(1) 교통 (2) 공간적 상호 작용이란, 여러 지역 사이에 발생하는 사람, 물자, 정보, 자본 등의 흐름을 의미한다. 비행기를 타고 해외여행을 하거나, 외국의 스포츠 경기를 실시간으로 보는 것, 스마트폰으로 음식을 주문하고 받는 것 등을 사례로 들 수 있다."], ["서술02", 21, "㉠ - 세계화, ㉡ - 지역화"], ["서술03", 21, "(1) 문화의 세계화 (2) 세계 각국의 다양한 음악, 영화, 음식, 스포츠 등을 일상생활에서도 쉽게 즐길 수 있게 되면서 우리의 삶도 더욱 풍요로워지고 있다. 그러나 각 지역 고유문화의 정체성이 약화되고, 세계 각 지역의 문화가 유사해지는 현상이 발생하였다."], ["서술04", 21, "지역 축제, 지역 축제는 매력적인 지역 이미지를 만들고, 지역을 홍보하는 데 매우 효과적인 수단으로 관광 산업 발달과 지역 경제 활성화에 기여한다."], ["개념01", 32, "ㄷ, ㄹ, ㅂ"], ["개념02", 32, "(1) ㄴ (2) ㄷ (3) ㄱ"], ["개념03", 32, "(1) ◯ (2) × (3) ◯ (4) ×"], ["개념04", 32, "계절풍"], ["개념05", 32, "㉠ 히말라야 ㉡ 사막"], ["대표01", 32, "①"], ["대표02", 32, "③"], ["대표03", 32, "②"], ["대표04", 32, "①"], ["대표05", 32, "①"], ["대표06", 33, "⑤"], ["대표07", 33, "③"], ["대표07-1", 33, "②"], ["대표08", 33, "①"], ["대표09", 33, "④"], ["대표10", 34, "①"], ["대표11", 34, "⑤"], ["대표12", 34, "⑤"], ["대표13", 34, "③"], ["대표14", 34, "③"], ["서술01", 35, "서남아시아, 사우디아라비아 등"], ["서술02", 35, "(1) 건조 (2) 유목, 건조 기후 지역은 강수량이 적어 농사를 짓기 어렵기 때문에 이 지역의 주민들은 가축에게 먹일 물과 풀을 찾아 이동하는 유목 생활을 한다."], ["서술03", 35, "열대 기후, 지면에서 올라오는 습기와 해충을 피하기 위해 기둥을 높이 세우고 땅에서 바닥을 띄워 지었다."], ["서술04", 35, "(1) 고원 (2) 황허강, 주변 토양이 비옥하고, 물을 구하기 쉬워 농경이 발달했기 때문이다."], ["개념01", 38, "(1) ◯ (2) × (3) × (4) ◯"], ["개념02", 38, "ㄷ, ㄹ"], ["개념03", 38, "(1) ㄴ (2) ㄹ (3) ㄱ (4)ㄷ"], ["개념04", 38, "㉠ 힌두교 ㉡ 이슬람교"], ["개념05", 38, "(1) 말레이시아 (2) 불교, 이슬람교 (3) 상대주의"], ["대표01", 38, "①"], ["대표02", 38, "①"], ["대표03", 38, "②"], ["대표04", 38, "③"], ["대표05", 38, "③"], ["대표05-1", 39, "④"], ["대표06", 39, "④"], ["대표07", 39, "④"], ["대표08", 39, "③"], ["대표09", 39, "③"], ["대표09-1", 40, "②"], ["대표10", 40, "③"], ["대표11", 40, "④"], ["대표12", 40, "③"], ["대표13", 40, "③"], ["서술01", 41, "(가) - 힌두교, (나) - 이슬람교"], ["서술02", 41, "(1) 힌두교 (2) 소를 먹는 것을 금기하는 문화와 갠지스강에서 목욕하는 것을 신성시하는 문화를 경험할 수 있다. 등"], ["서술03", 41, "이슬람교의 사원인 모스크는 둥근 모양의 지붕과 뾰족한 첨탑이 특징이며, 이슬람교에서는 돼지고기와 술을 금기한다. 등"], ["서술04", 41, "힌두교, 이슬람교"], ["서술05", 41, "종교가 다양한 말레이시아에서 각 종교가 평화롭게 공존할 수 있도록 하기 위해서이다."], ["개념01", 45, "(1) × (2) ◯ (3) ◯ (4) ×"], ["개념02", 45, "(1) ㄱ, ㄹ (2) ㄴ, ㄷ"], ["개념03", 45, "㉠ 저출산 ㉡ 고령화"], ["개념04", 45, "중국"], ["개념05", 45, "(1) 일본 (2) 사우디아라비아 (3) 베트남"], ["대표01", 45, "②"], ["대표02", 45, "②"], ["대표02-1", 45, "④"], ["대표03", 45, "③"], ["대표04", 45, "①"], ["대표05", 45, "③"], ["대표06", 46, "③"], ["대표07", 46, "④"], ["대표07-1", 46, "⑤"], ["대표08", 46, "③"], ["대표09", 46, "①"], ["대표10", 47, "③"], ["대표11", 47, "⑤"], ["대표12", 47, "④"], ["대표12-1", 47, "⑤"], ["대표13", 47, "③"], ["대표14", 48, "⑤"], ["대표15", 48, "②"], ["대표16", 48, "③"], ["대표17", 48, "①"], ["대표18", 48, "②"], ["서술01", 49, "(가) 국가는 (나) 국가에 비해 유소년층 인구 비율이 높으며, (나) 국가는 (가) 국가에 비해 노년층 인구 비율이 높다."], ["서술02", 49, "카타르에 일자리 수요가 늘어나면서 젊은 남성 이주 노동자들이 증가했기 때문이다."], ["서술03", 49, "연금 제도 등 사회 보장 제도를 정비하고, 노인 일자리를 창출하는 방안 등이 있다."], ["서술04", 49, "(가) - 석유, (나) - 석탄"], ["서술05", 49, "노동 집약적인 제조업의 신발의 공장이 기존 생산국"], ["개념01", 60, "(1) 아시아 (2) 남부 (3) 낙농업"], ["개념02", 60, "(1) 파리 (2) 온대 (3) 빙하"], ["개념03", 60, "(1) ◯ (2) × (3) ×"], ["개념04", 60, "편서풍"], ["개념05", 60, "㉠ 우랄 ㉡ 아시아"], ["대표01", 60, "①"], ["대표02", 60, "⑤"], ["대표03", 60, "①"], ["대표04", 60, "⑤"], ["대표05", 60, "①"], ["대표06", 61, "②"], ["대표07", 61, "③"], ["대표08", 61, "⑤"], ["대표08-1", 61, "②"], ["대표09", 61, "⑤"], ["대표09-1", 62, "④"], ["대표10", 62, "③"], ["대표11", 62, "③"], ["대표12", 62, "③"], ["대표13", 62, "①"], ["서술01", 63, "런던의 여름은 서늘하고 습윤한 반면, 리스본의 여름은 덥고 비가 적게 내려 건조하다."], ["서술02", 63, "수목 농업"], ["서술03", 63, "유럽의 중부 지역은 지대가 낮고 평탄한 평원이 나타나고, 남부 지역은 해발 고도가 높은 산지가 나타난다."], ["서술04", 63, "(1) 혼합 농업 (2) 흐리고 비가 내리는 날이 많아 우산을 가지고 다닌다. 맑은 날에 일광욕을 즐긴다. 등"], ["개념01", 66, "(1) × (2) ◯ (3) ◯ (4) ×"], ["개념02", 66, "(1) 세계 (2) 지속가능한"], ["개념03", 66, "(1) ㄷ (2) ㄱ (3) ㄴ"], ["개념04", 66, "불가능하다 → 가능하다"], ["개념05", 66, "ㄴ, ㄷ, ㄹ"], ["대표01", 66, "③"], ["대표02", 66, "②"], ["대표03", 66, "⑤"], ["대표04", 66, "②"], ["대표04-1", 66, "①"], ["대표05", 67, "②"], ["대표06", 67, "③"], ["대표07", 67, "③"], ["대표08", 67, "④"], ["대표09", 67, "③"], ["대표09-1", 68, "⑤"], ["대표10", 68, "①"], ["대표11", 68, "②"], ["대표12", 68, "⑤"], ["대표13", 68, "③"], ["서술01", 69, "프랑스의 니스, 스위스의 인터라켄, 아이슬란드의 레이캬비크 등은 특색 있는 자연환경을 바탕으로 성장한 관광 도시들이다."], ["서술02", 69, "(1) 지속가능한 도시 (2) 신·재생 에너지를 사용한 친환경 도시를 조성한다. 화석 에너지를 사용하는 교통수단 대신 자전거, 트램과"], ["개념01", 80, "(1) 대서양 (2) 북부 (3) 플랜테이션"], ["개념02", 80, "(1) 서부 (2) 사바나 (3) 건조"], ["개념03", 80, "(1) ◯ (2) ◯ (3) × (4) ×"], ["개념04", 80, "㉠ 사하라 ㉡ 북부"], ["대표01", 80, "③"], ["대표02", 80, "③"], ["대표03", 80, "①"], ["대표04", 80, "⑤"], ["대표05", 80, "②"], ["대표06", 81, "③"], ["대표07", 81, "⑤"], ["대표08", 81, "③"], ["대표08-1", 81, "④"], ["대표09", 81, "①"], ["대표09-1", 82, "④"], ["대표10", 82, "④"], ["대표11", 82, "④"], ["대표12", 82, "③"], ["대표13", 82, "④"], ["서술01", 83, "아프리카는 직선 형태의 국경선이 많다. 이는 과거 아프리카를 식민 지배했던 유럽이 지역의 부족 분포를 고려하지 않고 국경선을 그었기 때문이다. 이에 따라 아프리카 여러 지역에서는 부족 간 갈등이 발생하고 있다."], ["서술02", 83, "(1) (가) - 열대 기후, (나) - 건조 기후"], ["개념01", 86, "(1) 건조 (2) 큰 (3) 크리스트교 (4) 높다"], ["개념02", 86, "(1) × (2) ◯ (3) ◯"], ["개념03", 86, "(1) 건조 (2) 아프리카 연합(AU)"], ["개념04", 86, "공정 여행"], ["개념05", 86, "ㄱ, ㄴ, ㄷ"], ["대표01", 86, "④"], ["대표02", 86, "②"], ["대표02-1", 86, "②"], ["대표03", 86, "②"], ["대표04", 86, "③"], ["대표05", 87, "④"], ["대표06", 87, "③"], ["대표06-1", 87, "②"], ["대표07", 87, "④"], ["대표08", 87, "⑤"], ["대표09", 88, "⑤"], ["대표10", 88, "⑤"], ["대표11", 88, "②"], ["대표12", 88, "②"], ["대표13", 88, "③"], ["서술01", 89, "(가)는 강수량이 적고 일교차가 큰 건조 기후 지역의 의복으로, 강한 햇볕과 모래바람을 막기 위해 얇은 천으로 온몸을 감싸는 형태의 옷이 발달하였다. (나)는 열대 기후 지역의 의복으로, 덥고 습한 기후에 적합한 얇고 짧은 옷이 발달하였다."], ["서술02", 89, "건조 기후 지역에서는 오아시스 주변에서 대추야자나 밀 등을 주로 재배한다. 또한 진흙을 활용해 벽이 두껍고 창문이 작은 형태의 집을 짓는다."], ["서술03", 89, "아프리카의 중위 연령은 다른 대륙에 비해 낮다. 장차 경제활동이 가능한 청장년층 인구가 많기 때문에 지역의 성장 잠재력이 높다."], ["개념01", 100, "(1) 파나마 지협 (2) 캐나다 (3) 고산 (4) 환태평양 조산대"], ["개념02", 100, "(1) 태평양 (2) 북아메리카 (3) 애팔래치아 (4) 아마존강"], ["개념03", 100, "(1) × (2) ◯ (3) ×"], ["개념04", 100, "미시시피강"], ["개념05", 100, "㉠ 로키 ㉡ 애팔래치아"], ["대표01", 100, "②"], ["대표02", 100, "②"], ["대표03", 100, "③"], ["대표04", 100, "①"], ["대표05", 100, "②"], ["대표05-1", 100, "①"], ["대표06", 101, "⑤"], ["대표07", 101, "⑤"], ["대표08", 101, "④"], ["대표09", 101, "②"], ["대표10", 101, "④"], ["대표11", 102, "②"], ["대표12", 102, "①"], ["대표13", 102, "②"], ["대표14", 102, "④"], ["대표14-1", 102, "②"], ["서술01", 103, "㉠ - 파나마 지협, ㉡ - 리오그란데강"], ["서술02", 103, "세계 도시"], ["서술03", 103, "고산 기후, 적도 주변의 안데스산맥 일대는 해발 고도가 높아 연중 온화한 봄과 같은 기후가 나타난다. 고산 기후 지역은 저지대의 열대 기후 지역보다 인간 생활에 적합하여 일찍부터 사람이 거주하면서 도시가 발달하였다."], ["서술04", 103, "(1) (가) - 로키산맥, (나) - 애팔래치아산맥 (2) (가) 지역은 형성 시기가 오래되지 않은 높고 험준한 산맥이 남북으로 뻗어 있고, 태평양 연안을 따라 화산과"], ["개념01", 106, "(1) 히스패닉 (2) 유럽계 (3) 안데스 (4) 초국적 기업"], ["개념02", 106, "(1) ㄱ (2) ㄷ (3) ㄴ"], ["개념03", 106, "(1) × (2) × (3) ◯ (4) ◯"], ["개념04", 106, "㉠ 리우 카니발 ㉡ 문화 혼종성"], ["개념05", 106, "산업 공동화"], ["대표01", 106, "①"], ["대표02", 106, "①"], ["대표03", 106, "③"], ["대표04", 106, "④"], ["대표05", 106, "③"], ["대표06", 106, "④"], ["대표07", 107, "④"], ["대표08", 107, "④"], ["대표08-1", 107, "④"], ["대표09", 107, "⑤"], ["대표10", 107, "②"], ["대표11", 108, "③"], ["대표12", 108, "③"], ["대표13", 108, "⑤"], ["대표14", 108, "③"], ["대표15", 108, "②"], ["서술01", 109, "(1) (가) - 영어, (나) - 프랑스어 (2) 캐나다 동부의 퀘벡주는 과거 프랑스의 식민 지배 영향으로 프랑스계 이주민의 비율이 높아 프랑스어의 사용 비율이 높다."], ["서술02", 109, "문화 혼종성"], ["개념01", 120, "(1) 태평양 (2) 캔버라 (3) 온대"], ["개념02", 120, "(1) 남반구 (2) 화산, 빙하 (3) 기업적 농목업"], ["개념03", 120, "(1) ◯ (2) ◯ (3) × (4) ×"], ["개념04", 120, "대보초(그레이트 배리어 리프)"], ["개념05", 120, "찬정"], ["대표01", 120, "⑤"], ["대표02", 120, "①"], ["대표03", 120, "⑤"], ["대표04", 120, "①"], ["대표05", 120, "④"], ["대표06", 121, "⑤"], ["대표07", 121, "④"], ["대표07-1", 121, "⑤"], ["대표08", 121, "④"], ["대표09", 121, "②"], ["대표10", 122, "⑤"], ["대표11", 122, "⑤"], ["대표12", 122, "②"], ["대표12-1", 122, "②"], ["대표13", 122, "⑤"], ["서술01", 123, "오스트레일리아의 남동부와 남서부 해안은 온대 기후가 나타나는 곳으로, 기후가 온화하여 인간 생활 및 경제활동을 하기에 유리하기 때문이다."], ["개념01", 126, "(1) 미세 플라스틱 (2) 지구 온난화 (3) 석유"], ["개념02", 126, "(1) 줄이기 (2) 한대 (3) 남극"], ["개념03", 126, "(1) × (2) × (3) ◯"], ["개념04", 126, "㉠ 해양 쓰레기 ㉡ 해수면 상승"], ["개념05", 126, "주장할 수 있다 → 주장할 수 없다"], ["대표01", 126, "⑤"], ["대표02", 126, "③"], ["대표03", 126, "②"], ["대표04", 126, "③"], ["대표05", 126, "②"], ["대표05-1", 127, "⑤"], ["대표06", 127, "⑤"], ["대표07", 127, "①"], ["대표08", 127, "②"], ["대표09", 127, "④"], ["대표10", 128, "③"], ["대표11", 128, "⑤"], ["대표12", 128, "⑤"], ["대표13", 128, "③"], ["대표14", 128, "①"], ["서술01", 129, "플라스틱 사용량 줄이기, 일회용 컵이 아닌 다회용 컵 사용하기, 쓰레기는 분리배출하기, 장바구니 사용하기, 쓰레기 줍기 등"], ["서술02", 129, "(1) 지구 온난화 (2) 지역 주민의 삶터가 바닷물에 잠길 수 있고, 지하수에 염분이 스며들어 식수 사용도 어려워진다. 농경지가 침수되고 농작물이 염해 피해를 입을 수 있다."], ["서술03", 129, "긍정적인 측면으로는 항로의 운송 거리와 시간이 단축되고, 자원 개발에 따른 경제적 이익이 증가하거나 극지 환경 체험 등의 관광 산업이 발달할 수 있다. 부정적인 측면으로는 자연환경 및 생태계가 파괴되고, 원주민의 고유문화가 사라질 수 있다."], ["서술04", 129, "남극 조약은 남극에서의 군사 활동, 원자력 활동, 폐기물 배출 등을 금지하고, 환경 보호와 생물 다양성 보존, 과학적 연구 및 국제 협력을 촉진하는 것을 목적으로 한다. 또한 조약 가입국들은 남극에 관한 권리나 주장을 포기하며, 남극에서의 평화적인 활동을 보장하기 위해 상호 협력을 강화하고 있다."]]